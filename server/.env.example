# AI Photo Animator Server Configuration

# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# Google Cloud Services (Optional - for enhanced TTS and Translation)
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/google-credentials.json
GOOGLE_CLOUD_PROJECT_ID=your-project-id

# OpenAI Configuration (Optional - for enhanced AI features)
OPENAI_API_KEY=your-openai-api-key

# Replicate Configuration (Optional - for AI models)
REPLICATE_API_TOKEN=your-replicate-api-token

# Remove.bg API (Optional - for better background removal)
REMOVEBG_API_KEY=your-removebg-api-key

# File Upload Configuration
MAX_FILE_SIZE=50MB
UPLOAD_TIMEOUT=300000

# Video Generation Configuration
MAX_VIDEO_DURATION=300
DEFAULT_VIDEO_QUALITY=4k
ENABLE_HDR=false

# Audio Configuration
DEFAULT_SAMPLE_RATE=48000
DEFAULT_AUDIO_BITRATE=256k

# Performance Configuration
MAX_CONCURRENT_JOBS=3
CLEANUP_TEMP_FILES=true
TEMP_FILE_RETENTION_HOURS=24

# Security Configuration
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Database Configuration (Optional - for user management)
# DATABASE_URL=postgresql://username:password@localhost:5432/ai_photo_animator
# REDIS_URL=redis://localhost:6379

# External AI Services (Optional)
# AZURE_COGNITIVE_SERVICES_KEY=your-azure-key
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-east-1